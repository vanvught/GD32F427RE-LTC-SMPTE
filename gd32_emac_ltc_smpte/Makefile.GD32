BOARD=BOARD_GD32F427RE
#BOARD=BOARD_GD32F407RE

ENET_PHY=RTL8201F

DEFINES =NODE_LTC_SMPTE

DEFINES+=ENET_DISABLE_PA8
DEFINES+=CONFIG_CLIB_USE_UART0

DEFINES+=CONFIG_MDNS_DOMAIN_REVERSE

DEFINES+=CONFIG_DISPLAY_ENABLE_CURSOR_MODE

DEFINES+=ENABLE_HTTPD

DEFINES+=CONFIG_NET_ENABLE_PTP
DEFINES+=CONFIG_NET_ENABLE_PTP_NTP_CLIENT

DEFINES+=CONFIG_NTP_CLIENT_DISABLE_TIMEUPDATE

DEFINES+=UDP_MAX_PORTS_ALLOWED=16

DEFINES+=ENABLE_USB_DEVICE USE_USB_FS
DEFINES+=CONFIG_USB_DEVICE_MIDI

DEFINES+=CONFIG_DISPLAY_ENABLE_SSD1311 
DEFINES+=CONFIG_DISPLAY_ENABLE_CURSOR_MODE

#DEFINES+=CONFIG_FATFS_USE_SPI
DEFINES+=DISABLE_FS

DEFINES+=CONFIG_DEBUG_I2C
DEFINES+=CONFIG_DEBUG_STACK
DEFINES+=CONFIG_DEBUG_TRACE
#DEFINES+=CONFIG_DEBUG_DUMP

#DEFINES+=DEBUG_BOARD
#DEFINES+=DEBUG_GD32_TIMERS
#DEFINES+=DEBUG_SUPERLOOP_TIMERS

#DEFINES+=DEBUG_LTC
DEFINES+=DEBUG_LTC_INPUT
#DEFINES+=DEBUG_LTC_OUTPUT
#DEFINES+=DEBUG_LTC_DISPLAY
#DEFINES+=DEBUG_LTC_GPS
#DEFINES+=DEBUG_LTC_NTPCLIENT
#DEFINES+=DEBUG_LTC_NTPSERVER
#DEFINES+=DEBUG_LTC_NETWORK_NTPSERVER
DEFINES+=DEBUG_LTC_OSCSERVER
#DEFINES+=DEBUG_LTC_PTP

#DEFINES+=DEBUG_LTC_TIMER0
#DEFINES+=DEBUG_LTC_TIMER3

#DEFINES+=DEBUG_PTP_NTP_CLIENT
#DEFINES+=DEBUG_APPLEMIDI
#DEFINES+=DEBUG_GPS
#DEFINES+=DEBUG_PIXEL_OUTPUT
#DEFINES+=DEBUG_TCNET

#DEFINES+=NDEBUG

SRCDIR=firmware lib lib/gps lib/pixel lib/midi/net lib/midi/usbd lib/ltc lib/ltc/display lib/ltc/systime lib/tcnet lib/network lib/ltc/network lib/shell

LIBS=

include ../firmware-template-gd32/Rules.mk

prerequisites:
