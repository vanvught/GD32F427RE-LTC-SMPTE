#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

PYTHON="${PYTHON:-python3}"
command -v "$PYTHON" >/dev/null 2>&1 || PYTHON=python
command -v "$PYTHON" >/dev/null 2>&1 || { echo "No python found (need python3)"; exit 1; }

VENV="$HOME/venvs/gd32-common"
PY="$VENV/bin/python"

if [[ ! -x "$PY" ]]; then
  "$PYTHON" -m venv "$VENV" || {
    echo "Failed to create venv. On Debian/Ubuntu install: python3-venv" >&2
    exit 1
  }
fi

"$PY" -m pip install -q -U pip
"$PY" -m pip install -q pyserial

exec "$PY" "$DIR/flash.py" "$@"